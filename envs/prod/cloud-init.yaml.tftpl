#cloud-config
# First-boot setup only: installs Docker and drops the app's runtime env file.
# Application code is deployed separately (see README).
package_update: true
package_upgrade: true
packages:
  - docker.io
  - docker-compose-v2
  - unattended-upgrades

write_files:
  - path: /opt/ipcservices/.env
    permissions: "0600"
    owner: root:root
    content: |
      NODE_ENV=production
      PORT=5000
      DB_HOST=${db_host}
      DB_PORT=${db_port}
      DB_NAME=${db_name}
      DB_USERNAME=${db_user}
      DB_PASSWORD=${db_pass}
      DB_SSL=true
      TYPEORM_SYNCHRONIZE=false
      TYPEORM_LOGGING=false
      JWT_SECRET=${jwt_secret}

runcmd:
  - systemctl enable --now docker
