# Terraform local state and cache
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfplan

# Variable files that may hold real values (the .example file is committed)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local overrides
override.tf
override.tf.json
*_override.tf

# Secrets / OS
.env
.DS_Store

# NOTE: .terraform.lock.hcl IS committed on purpose.
